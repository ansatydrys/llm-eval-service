# Copy to .env. Everything works with the defaults below: no API keys, no paid calls.
POSTGRES_USER=eval
POSTGRES_PASSWORD=eval
POSTGRES_DB=llm_eval
DATABASE_URL=postgresql+psycopg://eval:eval@db:5432/llm_eval

# Dataset limits
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_CASES=1000

# Hard ceilings for run configs (requests above them are rejected with 422)
MAX_CASES_PER_RUN=500
MAX_ATTEMPTS_CEILING=5
MAX_OUTPUT_TOKENS_CEILING=1024
MAX_TIMEOUT_S=60

# Worker. LEASE_SECONDS must be greater than MAX_TIMEOUT_S.
LEASE_SECONDS=120
POLL_INTERVAL_S=1
RETRY_BACKOFF_BASE_S=1
RETRY_BACKOFF_MAX_S=30

# Real provider: disabled unless explicitly enabled. The key is read from the
# environment only; it is never stored in the database or written to logs.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
